{
  "name": "ve-rich-text-editor",
  "version": "1.1.0",
  "description": "Drop-in rich text editor for React and Next.js, built on Tiptap.",
  "author": "Venky225141125 <venkatesh.edubilli@gmail.com>",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./style.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "lint": "tsc --noEmit",
    "test": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server.cjs",
    "prepack": "npm run build"
  },
  "keywords": [
    "react",
    "rich-text-editor",
    "tiptap",
    "nextjs",
    "editor",
    "component-library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venky225141125/ve.git"
  },
  "homepage": "https://github.com/Venky225141125/ve",
  "bugs": {
    "url": "https://github.com/Venky225141125/ve/issues"
  },
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@tiptap/core": "^3.30.1",
    "@tiptap/extension-character-count": "^3.30.1",
    "@tiptap/extension-color": "^3.30.1",
    "@tiptap/extension-font-family": "^3.30.1",
    "@tiptap/extension-highlight": "^3.30.1",
    "@tiptap/extension-image": "^3.30.1",
    "@tiptap/extension-link": "^3.30.1",
    "@tiptap/pm": "^3.30.1",
    "@tiptap/extension-placeholder": "^3.30.1",
    "@tiptap/extension-subscript": "^3.30.1",
    "@tiptap/extension-superscript": "^3.30.1",
    "@tiptap/extension-table": "^3.30.1",
    "@tiptap/extension-table-cell": "^3.30.1",
    "@tiptap/extension-table-header": "^3.30.1",
    "@tiptap/extension-table-row": "^3.30.1",
    "@tiptap/extension-task-item": "^3.30.1",
    "@tiptap/extension-task-list": "^3.30.1",
    "@tiptap/extension-text-align": "^3.30.1",
    "@tiptap/extension-text-style": "^3.30.1",
    "@tiptap/extension-underline": "^3.30.1",
    "@tiptap/extension-youtube": "^3.30.1",
    "@tiptap/react": "^3.30.1",
    "@tiptap/starter-kit": "^3.30.1",
    "dompurify": "^3.4.13",
    "lucide-react": "^0.546.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
